---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- Built automatically by Jekyll: lists every page and post so search engines can find them -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.html_pages %}{% unless page.url == "/404.html" %}
  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>
  </url>
{% endunless %}{% endfor %}
{% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
{% endfor %}
</urlset>
